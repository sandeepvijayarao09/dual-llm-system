# ── Models: each role is a provider + model ───────────────────────────────────
# Small role: Gemma 4 E4B, run locally by Ollama (`ollama pull gemma4:e4b`).
# SMALL_PROVIDER=ollama        # ollama | gemini
# SMALL_MODEL=gemma4:e4b
# OLLAMA_BASE_URL=http://localhost:11434

# Large role: Gemini (paid). Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# LARGE_PROVIDER=gemini
# LARGE_MODEL=gemini-3.8-flash # or gemini-4-argon (stronger, ~2.7x the price)
# Free alternative (Gemini API free tier, rate-limited): LARGE_MODEL=gemma-4-31b-it

# ── Routing thresholds ────────────────────────────────────────────────────────
# CONFIDENCE_THRESHOLD=0.75            # min LLM-classifier confidence to trust "small"
# ML_ROUTER_CONFIDENCE_THRESHOLD=0.65  # below this the LLM classifier decides
# LARGE_INPUT_THRESHOLD=2000           # words; longer queries skip routing

# ── Timeouts (seconds) ────────────────────────────────────────────────────────
# SMALL_LLM_TIMEOUT=60
# LARGE_LLM_TIMEOUT=120

# ── Storage ───────────────────────────────────────────────────────────────────
# One database for profiles + routing log (Postgres in production):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dual_llm
# Without DATABASE_URL, two SQLite files are used:
# DB_PATH=profiles.db
# ROUTING_LOG_PATH=routing_log.db

# ── Cost accounting ───────────────────────────────────────────────────────────
# JSON file that adds or overrides model prices (USD per 1M tokens):
# MODEL_PRICES_PATH=prices.json

# ── HTTP API ──────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000"]
