# ── Providers ─────────────────────────────────────────────────────────────────
# Set the key for each provider you use. OPENAI_API_KEY is required for the
# defaults below.
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── Models: each role is a provider + model ───────────────────────────────────
# SMALL_PROVIDER=openai        # openai | anthropic | gemini
# SMALL_MODEL=gpt-4o-mini
# LARGE_PROVIDER=openai
# LARGE_MODEL=gpt-4o
# Example, all-Claude cascade:
#   SMALL_PROVIDER=anthropic SMALL_MODEL=claude-haiku-5-5
#   LARGE_PROVIDER=anthropic LARGE_MODEL=claude-opus-5-5

# ── Routing thresholds ────────────────────────────────────────────────────────
# CONFIDENCE_THRESHOLD=0.75            # min LLM-classifier confidence to trust "small"
# ML_ROUTER_CONFIDENCE_THRESHOLD=0.65  # below this the LLM classifier decides
# LARGE_INPUT_THRESHOLD=2000           # words; longer queries skip routing

# ── Timeouts (seconds) ────────────────────────────────────────────────────────
# SMALL_LLM_TIMEOUT=60
# LARGE_LLM_TIMEOUT=120

# ── Storage ───────────────────────────────────────────────────────────────────
# One database for profiles + routing log (Postgres in production):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dual_llm
# Without DATABASE_URL, two SQLite files are used:
# DB_PATH=profiles.db
# ROUTING_LOG_PATH=routing_log.db

# ── Cost accounting ───────────────────────────────────────────────────────────
# JSON file that adds or overrides model prices (USD per 1M tokens), e.g. for Gemini:
# MODEL_PRICES_PATH=prices.json

# ── HTTP API ──────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000"]
